import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 28

Contest 52 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 7,098
ballots as `contestBallots` reads them, in 255 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict28.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 23`: Rachel M. Allen
* `.regular 24`: Jesse M. Sumner
* `.regular 25`: Jessica Wright
* `.regular 26`: Steve Menard
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Jessica Wright, then Rachel M. Allen, and elects Jesse M. Sumner
  over Steve Menard.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Jessica Wright, then Rachel M. Allen,
  and elects Jesse M. Sumner over Steve Menard.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict28

open Alaska

def cands : List Cand := [.regular 23, .regular 24, .regular 25, .regular 26, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 52
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict28.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 25, .branch [(.regular 23, .branch [(.regular 26, .winner (.regular 24))])])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 25, .branch [(.regular 23, .branch [(.regular 26, .winner (.regular 24))])])] := by
  decide +kernel

/-- `tabulate` defeats Jessica Wright, then Rachel M. Allen, and elects Jesse M. Sumner over Steve
Menard. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 25, .branch [(.regular 23, .branch [(.regular 26, .winner (.regular 24))])])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Jessica Wright, then Rachel M. Allen, and elects Jesse M. Sumner
over Steve Menard. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 25, .branch [(.regular 23, .branch [(.regular 26, .winner (.regular 24))])])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 52).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [23, 24, 25, 26] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [23, 24, 25, 26] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict28
