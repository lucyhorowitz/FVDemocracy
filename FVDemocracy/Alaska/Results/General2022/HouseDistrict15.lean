import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 15

Contest 39 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 7,709
ballots as `contestBallots` reads them, in 98 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict15.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 59`: Denny Wells
* `.regular 60`: David Eibeck
* `.regular 61`: Thomas W. "Tom" McKay
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats David Eibeck and elects Thomas W. "Tom" McKay over Denny Wells.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats David Eibeck and elects Thomas W. "Tom"
  McKay over Denny Wells.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict15

open Alaska

def cands : List Cand := [.regular 59, .regular 60, .regular 61, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 39
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict15.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 60, .branch [(.regular 59, .winner (.regular 61))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 60, .branch [(.regular 59, .winner (.regular 61))])] := by
  decide +kernel

/-- `tabulate` defeats David Eibeck and elects Thomas W. "Tom" McKay over Denny Wells. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 60, .branch [(.regular 59, .winner (.regular 61))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats David Eibeck and elects Thomas W. "Tom" McKay over Denny Wells.
-/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 60, .branch [(.regular 59, .winner (.regular 61))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 39).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [59, 60, 61] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [59, 60, 61] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict15
