import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 35

Contest 59 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 7,878
ballots as `contestBallots` reads them, in 208 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict35.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 280`: Kieran C. Brown
* `.regular 277`: Ashley E. Carrick
* `.regular 275`: Kevin McKinley
* `.regular 276`: Ruben A. Jr. McNeill
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Ashley E. Carrick in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Ashley E. Carrick in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict35

open Alaska

def cands : List Cand := [.regular 280, .regular 277, .regular 275, .regular 276, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 59
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict35.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 277) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 277) := by
  decide +kernel

/-- `tabulate` elects Ashley E. Carrick in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 277) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Ashley E. Carrick in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 277) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.HouseDistrict35
