import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: Senate District D

Contest 9 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 16,236
ballots as `contestBallots` reads them, in 163 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/SenateDistrictD.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 132`: Tuckerman Babcock
* `.regular 133`: Jesse J. Bjorkman
* `.regular 134`: Andy Cizek
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Andy Cizek and elects Jesse J. Bjorkman over Tuckerman Babcock.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Andy Cizek and elects Jesse J. Bjorkman
  over Tuckerman Babcock.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.SenateDistrictD

open Alaska

def cands : List Cand := [.regular 132, .regular 133, .regular 134, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 9
    "FVDemocracy/Alaska/Results/data/General2022/SenateDistrictD.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 134, .branch [(.regular 132, .winner (.regular 133))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 134, .branch [(.regular 132, .winner (.regular 133))])] := by
  decide +kernel

/-- `tabulate` defeats Andy Cizek and elects Jesse J. Bjorkman over Tuckerman Babcock. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 134, .branch [(.regular 132, .winner (.regular 133))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Andy Cizek and elects Jesse J. Bjorkman over Tuckerman Babcock.
-/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 134, .branch [(.regular 132, .winner (.regular 133))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 9).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [132, 133, 134] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [132, 133, 134] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.SenateDistrictD
