import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: Senate District F

Contest 11 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 14,964
ballots as `contestBallots` reads them, in 43 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/SenateDistrictF.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 127`: James D. Kaufman
* `.regular 128`: Janice L. Park
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects James D. Kaufman in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects James D. Kaufman in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.SenateDistrictF

open Alaska

def cands : List Cand := [.regular 127, .regular 128, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 11
    "FVDemocracy/Alaska/Results/data/General2022/SenateDistrictF.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 127) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 127) := by
  decide +kernel

/-- `tabulate` elects James D. Kaufman in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 127) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects James D. Kaufman in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 127) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.SenateDistrictF
