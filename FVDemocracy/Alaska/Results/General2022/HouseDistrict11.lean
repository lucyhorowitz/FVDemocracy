import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 11

Contest 35 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 8,190
ballots as `contestBallots` reads them, in 89 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict11.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 69`: Walter T. Featherly
* `.regular 70`: Ross P. Bieling
* `.regular 71`: Julie Coulombe
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Ross P. Bieling and elects Julie Coulombe over Walter T.
  Featherly.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Ross P. Bieling and elects Julie
  Coulombe over Walter T. Featherly.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict11

open Alaska

def cands : List Cand := [.regular 69, .regular 70, .regular 71, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 35
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict11.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 70, .branch [(.regular 69, .winner (.regular 71))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 70, .branch [(.regular 69, .winner (.regular 71))])] := by
  decide +kernel

/-- `tabulate` defeats Ross P. Bieling and elects Julie Coulombe over Walter T. Featherly. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 70, .branch [(.regular 69, .winner (.regular 71))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Ross P. Bieling and elects Julie Coulombe over Walter T.
Featherly. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 70, .branch [(.regular 69, .winner (.regular 71))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 35).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [69, 70, 71] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [69, 70, 71] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict11
