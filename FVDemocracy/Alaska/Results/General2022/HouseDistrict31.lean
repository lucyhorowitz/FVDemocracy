import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 31

Contest 55 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 5,330
ballots as `contestBallots` reads them, in 109 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict31.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 15`: Kelly Nash
* `.regular 16`: Maxine L. Dibert
* `.regular 17`: Barton S. LeBon
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Kelly Nash and elects Maxine L. Dibert over Barton S. LeBon.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Kelly Nash and elects Maxine L. Dibert
  over Barton S. LeBon.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict31

open Alaska

def cands : List Cand := [.regular 15, .regular 16, .regular 17, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 55
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict31.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 15, .branch [(.regular 17, .winner (.regular 16))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 15, .branch [(.regular 17, .winner (.regular 16))])] := by
  decide +kernel

/-- `tabulate` defeats Kelly Nash and elects Maxine L. Dibert over Barton S. LeBon. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 15, .branch [(.regular 17, .winner (.regular 16))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Kelly Nash and elects Maxine L. Dibert over Barton S. LeBon. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 15, .branch [(.regular 17, .winner (.regular 16))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 55).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [15, 16, 17] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [15, 16, 17] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict31
