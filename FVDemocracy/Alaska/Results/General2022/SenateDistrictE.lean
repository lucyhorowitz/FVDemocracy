import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: Senate District E

Contest 10 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 17,437
ballots as `contestBallots` reads them, in 139 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/SenateDistrictE.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 129`: Roger Holland
* `.regular 130`: Cathy Giessel
* `.regular 131`: Roselynn Cacy
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Roselynn Cacy and elects Cathy Giessel over Roger Holland.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Roselynn Cacy and elects Cathy Giessel
  over Roger Holland.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.SenateDistrictE

open Alaska

def cands : List Cand := [.regular 129, .regular 130, .regular 131, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 10
    "FVDemocracy/Alaska/Results/data/General2022/SenateDistrictE.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 131, .branch [(.regular 129, .winner (.regular 130))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 131, .branch [(.regular 129, .winner (.regular 130))])] := by
  decide +kernel

/-- `tabulate` defeats Roselynn Cacy and elects Cathy Giessel over Roger Holland. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 131, .branch [(.regular 129, .winner (.regular 130))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Roselynn Cacy and elects Cathy Giessel over Roger Holland. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 131, .branch [(.regular 129, .winner (.regular 130))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 10).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [129, 130, 131] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [129, 130, 131] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.SenateDistrictE
