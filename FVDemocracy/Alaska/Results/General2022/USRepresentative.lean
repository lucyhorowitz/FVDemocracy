import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: U.S. Representative

Contest 4 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 266,797
ballots as `contestBallots` reads them, in 1,773 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/USRepresentative.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 263`: Nick Begich
* `.regular 279`: Chris Bye
* `.regular 264`: Sarah Palin
* `.regular 265`: Mary S. Peltola
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Chris Bye, then Nick Begich, and elects Mary S. Peltola over
  Sarah Palin.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Chris Bye, then Nick Begich, and elects
  Mary S. Peltola over Sarah Palin.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.USRepresentative

open Alaska

def cands : List Cand := [.regular 263, .regular 279, .regular 264, .regular 265, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 4
    "FVDemocracy/Alaska/Results/data/General2022/USRepresentative.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 279, .branch [(.regular 263, .branch [(.regular 264, .winner (.regular 265))])])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 279, .branch [(.regular 263, .branch [(.regular 264, .winner (.regular 265))])])] := by
  decide +kernel

/-- `tabulate` defeats Chris Bye, then Nick Begich, and elects Mary S. Peltola over Sarah Palin. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 279, .branch [(.regular 263, .branch [(.regular 264, .winner (.regular 265))])])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Chris Bye, then Nick Begich, and elects Mary S. Peltola over
Sarah Palin. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 279, .branch [(.regular 263, .branch [(.regular 264, .winner (.regular 265))])])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 4).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [263, 279, 264, 265] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [263, 279, 264, 265] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.USRepresentative
