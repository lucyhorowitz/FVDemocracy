import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 27

Contest 51 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 6,678
ballots as `contestBallots` reads them, in 120 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict27.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 27`: Stuart R. "Stu" Graham
* `.regular 29`: Brendan R. Carpenter
* `.regular 28`: David Eastman
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects David Eastman in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects David Eastman in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict27

open Alaska

def cands : List Cand := [.regular 27, .regular 29, .regular 28, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 51
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict27.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 28) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 28) := by
  decide +kernel

/-- `tabulate` elects David Eastman in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 28) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects David Eastman in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 28) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.HouseDistrict27
