import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 18

Contest 42 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 2,297
ballots as `contestBallots` reads them, in 69 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict18.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 50`: Lyn D. Franks
* `.regular 51`: David Nelson
* `.regular 52`: Cliff Groh
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Lyn D. Franks and elects Cliff Groh over David Nelson.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Lyn D. Franks and elects Cliff Groh over
  David Nelson.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict18

open Alaska

def cands : List Cand := [.regular 50, .regular 51, .regular 52, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 42
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict18.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 50, .branch [(.regular 51, .winner (.regular 52))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 50, .branch [(.regular 51, .winner (.regular 52))])] := by
  decide +kernel

/-- `tabulate` defeats Lyn D. Franks and elects Cliff Groh over David Nelson. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 50, .branch [(.regular 51, .winner (.regular 52))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Lyn D. Franks and elects Cliff Groh over David Nelson. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 50, .branch [(.regular 51, .winner (.regular 52))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 42).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [50, 51, 52] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [50, 51, 52] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict18
