import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 30

Contest 54 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 8,135
ballots as `contestBallots` reads them, in 107 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict30.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 18`: Doyle E. Holmes
* `.regular 19`: Kevin J. McCabe
* `.regular 20`: L. Joy Mindiola
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats L. Joy Mindiola and elects Kevin J. McCabe over Doyle E. Holmes.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats L. Joy Mindiola and elects Kevin J.
  McCabe over Doyle E. Holmes.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict30

open Alaska

def cands : List Cand := [.regular 18, .regular 19, .regular 20, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 54
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict30.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 20, .branch [(.regular 18, .winner (.regular 19))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 20, .branch [(.regular 18, .winner (.regular 19))])] := by
  decide +kernel

/-- `tabulate` defeats L. Joy Mindiola and elects Kevin J. McCabe over Doyle E. Holmes. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 20, .branch [(.regular 18, .winner (.regular 19))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats L. Joy Mindiola and elects Kevin J. McCabe over Doyle E. Holmes.
-/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 20, .branch [(.regular 18, .winner (.regular 19))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 54).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [18, 19, 20] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [18, 19, 20] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict30
