import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: Senate District N

Contest 19 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 13,776
ballots as `contestBallots` reads them, in 173 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/SenateDistrictN.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 106`: Scott D. Clayton
* `.regular 107`: David S. Wilson
* `.regular 108`: Stephen Wright
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Scott D. Clayton and elects David S. Wilson over Stephen Wright.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Scott D. Clayton and elects David S.
  Wilson over Stephen Wright.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.SenateDistrictN

open Alaska

def cands : List Cand := [.regular 106, .regular 107, .regular 108, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 19
    "FVDemocracy/Alaska/Results/data/General2022/SenateDistrictN.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 106, .branch [(.regular 108, .winner (.regular 107))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 106, .branch [(.regular 108, .winner (.regular 107))])] := by
  decide +kernel

/-- `tabulate` defeats Scott D. Clayton and elects David S. Wilson over Stephen Wright. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 106, .branch [(.regular 108, .winner (.regular 107))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Scott D. Clayton and elects David S. Wilson over Stephen Wright.
-/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 106, .branch [(.regular 108, .winner (.regular 107))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 19).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [106, 107, 108] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [106, 107, 108] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.SenateDistrictN
