import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: U.S. Senator

Contest 3 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 266,797
ballots as `contestBallots` reads them, in 2,076 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/USSenator.json`, and writes that file from the export
first if it is missing. `cands` are the regular candidates of the contest followed by the write-ins
marked on its ballots:

* `.regular 271`: Patricia R. Chesbro
* `.regular 272`: Buzz A. Kelley
* `.regular 273`: Lisa Murkowski
* `.regular 274`: Kelly C. Tshibaka
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Buzz A. Kelley, then Patricia R. Chesbro, and elects Lisa
  Murkowski over Kelly C. Tshibaka.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Buzz A. Kelley, then Patricia R.
  Chesbro, and elects Lisa Murkowski over Kelly C. Tshibaka.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.USSenator

open Alaska

def cands : List Cand := [.regular 271, .regular 272, .regular 273, .regular 274, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 3
    "FVDemocracy/Alaska/Results/data/General2022/USSenator.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 272, .branch [(.regular 271, .branch [(.regular 274, .winner (.regular 273))])])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 272, .branch [(.regular 271, .branch [(.regular 274, .winner (.regular 273))])])] := by
  decide +kernel

/-- `tabulate` defeats Buzz A. Kelley, then Patricia R. Chesbro, and elects Lisa Murkowski over
Kelly C. Tshibaka. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 272, .branch [(.regular 271, .branch [(.regular 274, .winner (.regular 273))])])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Buzz A. Kelley, then Patricia R. Chesbro, and elects Lisa
Murkowski over Kelly C. Tshibaka. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 272, .branch [(.regular 271, .branch [(.regular 274, .winner (.regular 273))])])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 3).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [271, 272, 273, 274] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [271, 272, 273, 274] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.USSenator
