import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 34

Contest 58 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 7,693
ballots as `contestBallots` reads them, in 81 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict34.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 8`: Grier H. Hopkins
* `.regular 9`: Frank J. Tomaszewski
* `.regular 10`: Nate DeMars
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Nate DeMars and elects Frank J. Tomaszewski over Grier H.
  Hopkins.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Nate DeMars and elects Frank J.
  Tomaszewski over Grier H. Hopkins.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict34

open Alaska

def cands : List Cand := [.regular 8, .regular 9, .regular 10, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 58
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict34.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 10, .branch [(.regular 8, .winner (.regular 9))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 10, .branch [(.regular 8, .winner (.regular 9))])] := by
  decide +kernel

/-- `tabulate` defeats Nate DeMars and elects Frank J. Tomaszewski over Grier H. Hopkins. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 10, .branch [(.regular 8, .winner (.regular 9))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Nate DeMars and elects Frank J. Tomaszewski over Grier H.
Hopkins. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 10, .branch [(.regular 8, .winner (.regular 9))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-general" && r.contestId == 58).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [8, 9, 10] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [8, 9, 10] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2022.HouseDistrict34
