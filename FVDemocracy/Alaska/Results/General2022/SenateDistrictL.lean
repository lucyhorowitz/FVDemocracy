import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: Senate District L

Contest 17 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 16,332
ballots as `contestBallots` reads them, in 45 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/SenateDistrictL.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 113`: Ken McCarty
* `.regular 114`: Kelly R. Merrick
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Kelly R. Merrick in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Kelly R. Merrick in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.SenateDistrictL

open Alaska

def cands : List Cand := [.regular 113, .regular 114, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 17
    "FVDemocracy/Alaska/Results/data/General2022/SenateDistrictL.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 114) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 114) := by
  decide +kernel

/-- `tabulate` elects Kelly R. Merrick in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 114) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Kelly R. Merrick in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 114) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.SenateDistrictL
