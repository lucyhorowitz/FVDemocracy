import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 21

Contest 45 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 7,313
ballots as `contestBallots` reads them, in 38 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict21.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 42`: Forrest M. Wolfe
* `.regular 43`: Donna C. Mears
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Donna C. Mears in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Donna C. Mears in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict21

open Alaska

def cands : List Cand := [.regular 42, .regular 43, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 45
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict21.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 43) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 43) := by
  decide +kernel

/-- `tabulate` elects Donna C. Mears in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 43) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Donna C. Mears in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 43) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.HouseDistrict21
