import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: Senate District M

Contest 18 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 15,591
ballots as `contestBallots` reads them, in 39 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/SenateDistrictM.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 109`: Shelley Hughes
* `.regular 110`: Jim Cooper
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Shelley Hughes in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Shelley Hughes in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.SenateDistrictM

open Alaska

def cands : List Cand := [.regular 109, .regular 110, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 18
    "FVDemocracy/Alaska/Results/data/General2022/SenateDistrictM.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 109) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 109) := by
  decide +kernel

/-- `tabulate` elects Shelley Hughes in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 109) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Shelley Hughes in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 109) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.SenateDistrictM
