import FVDemocracy.Alaska.ProfileData

/-!
# 2022 general election: House District 24

Contest 48 of the CVR export `cvr/2022-general`. `profile` is `Profile.ofBallots` of its 7,996
ballots as `contestBallots` reads them, in 106 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2022/HouseDistrict24.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 34`: Daryl W. Nelson
* `.regular 35`: Sharon Jackson
* `.regular 36`: Dan Saddler
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Dan Saddler in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Dan Saddler in round 1.

Generated by `lake exe alaska cvr/2022-general --results 2022-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2022.HouseDistrict24

open Alaska

def cands : List Cand := [.regular 34, .regular 35, .regular 36, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-general" 48
    "FVDemocracy/Alaska/Results/data/General2022/HouseDistrict24.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 36) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 36) := by
  decide +kernel

/-- `tabulate` elects Dan Saddler in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 36) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Dan Saddler in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 36) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2022.HouseDistrict24
