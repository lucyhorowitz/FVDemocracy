import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: U.S. Representative

Contest 7 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 335,853
ballots as `contestBallots` reads them, in 1,814 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/USRepresentative.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 517`: Nick Begich
* `.regular 552`: Eric Hafner
* `.regular 520`: John Wayne Howe
* `.regular 518`: Mary S. Peltola
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Eric Hafner, then John Wayne Howe, and elects Nick Begich over
  Mary S. Peltola.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Eric Hafner, then John Wayne Howe, and
  elects Nick Begich over Mary S. Peltola.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.USRepresentative

open Alaska

def cands : List Cand := [.regular 517, .regular 552, .regular 520, .regular 518, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 7
    "FVDemocracy/Alaska/Results/data/General2024/USRepresentative.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 552, .branch [(.regular 520, .branch [(.regular 518, .winner (.regular 517))])])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 552, .branch [(.regular 520, .branch [(.regular 518, .winner (.regular 517))])])] := by
  decide +kernel

/-- `tabulate` defeats Eric Hafner, then John Wayne Howe, and elects Nick Begich over Mary S.
Peltola. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 552, .branch [(.regular 520, .branch [(.regular 518, .winner (.regular 517))])])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Eric Hafner, then John Wayne Howe, and elects Nick Begich over
Mary S. Peltola. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 552, .branch [(.regular 520, .branch [(.regular 518, .winner (.regular 517))])])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 7).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [517, 552, 520, 518] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [517, 552, 520, 518] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.USRepresentative
