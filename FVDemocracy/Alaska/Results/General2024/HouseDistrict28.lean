import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 28

Contest 55 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 8,915
ballots as `contestBallots` reads them, in 122 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict28.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 437`: Jessica Wright
* `.regular 438`: Steve Menard
* `.regular 439`: Elexie Moore
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Jessica Wright and elects Elexie Moore over Steve Menard.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Jessica Wright and elects Elexie Moore
  over Steve Menard.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict28

open Alaska

def cands : List Cand := [.regular 437, .regular 438, .regular 439, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 55
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict28.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 437, .branch [(.regular 438, .winner (.regular 439))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 437, .branch [(.regular 438, .winner (.regular 439))])] := by
  decide +kernel

/-- `tabulate` defeats Jessica Wright and elects Elexie Moore over Steve Menard. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 437, .branch [(.regular 438, .winner (.regular 439))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Jessica Wright and elects Elexie Moore over Steve Menard. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 437, .branch [(.regular 438, .winner (.regular 439))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 55).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [437, 438, 439] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [437, 438, 439] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.HouseDistrict28
