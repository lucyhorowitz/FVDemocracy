import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: U.S. President / Vice President

Contest 4 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 340,778
ballots as `contestBallots` reads them, in 15,202 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/USPresidentVicePresident.json`, and writes that file
from the export first if it is missing. `cands` are the regular candidates of the contest followed
by the write-ins marked on its ballots:

* `.regular 542`: Harris/Walz
* `.regular 554`: Kennedy/Shanahan
* `.regular 540`: Oliver/Maat
* `.regular 547`: Sonski/Onak
* `.regular 545`: Stein/Ware
* `.regular 546`: Terry/Broden
* `.regular 543`: Trump/Vance
* `.regular 541`: West/Abdullah

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Trump/Vance in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Trump/Vance in round 1.

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.USPresidentVicePresident

open Alaska

def cands : List Cand := [.regular 542, .regular 554, .regular 540, .regular 547, .regular 545, .regular 546, .regular 543, .regular 541]

def profile : Profile :=
  profile_data% "cvr/2024-general" 4
    "FVDemocracy/Alaska/Results/data/General2024/USPresidentVicePresident.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 543) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 543) := by
  decide +kernel

/-- `tabulate` elects Trump/Vance in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 543) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Trump/Vance in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 543) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2024.USPresidentVicePresident
