import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 6

Contest 33 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 11,798
ballots as `contestBallots` reads them, in 113 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict6.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 391`: Sarah L. Vance
* `.regular 392`: Brent Johnson
* `.regular 393`: Dawson R. Slaughter
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Dawson R. Slaughter and elects Sarah L. Vance over Brent
  Johnson.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Dawson R. Slaughter and elects Sarah L.
  Vance over Brent Johnson.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict6

open Alaska

def cands : List Cand := [.regular 391, .regular 392, .regular 393, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 33
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict6.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 393, .branch [(.regular 392, .winner (.regular 391))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 393, .branch [(.regular 392, .winner (.regular 391))])] := by
  decide +kernel

/-- `tabulate` defeats Dawson R. Slaughter and elects Sarah L. Vance over Brent Johnson. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 393, .branch [(.regular 392, .winner (.regular 391))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Dawson R. Slaughter and elects Sarah L. Vance over Brent Johnson.
-/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 393, .branch [(.regular 392, .winner (.regular 391))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 33).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [391, 392, 393] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [391, 392, 393] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.HouseDistrict6
