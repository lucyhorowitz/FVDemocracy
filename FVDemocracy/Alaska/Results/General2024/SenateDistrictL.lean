import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: Senate District L

Contest 19 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 20,340
ballots as `contestBallots` reads them, in 146 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/SenateDistrictL.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 537`: Jared D. Goecker
* `.regular 536`: Kelly R. Merrick
* `.regular 551`: Lee E. Hammermeister
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Lee E. Hammermeister and elects Kelly R. Merrick over Jared D.
  Goecker.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Lee E. Hammermeister and elects Kelly R.
  Merrick over Jared D. Goecker.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.SenateDistrictL

open Alaska

def cands : List Cand := [.regular 537, .regular 536, .regular 551, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 19
    "FVDemocracy/Alaska/Results/data/General2024/SenateDistrictL.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 551, .branch [(.regular 537, .winner (.regular 536))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 551, .branch [(.regular 537, .winner (.regular 536))])] := by
  decide +kernel

/-- `tabulate` defeats Lee E. Hammermeister and elects Kelly R. Merrick over Jared D. Goecker. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 551, .branch [(.regular 537, .winner (.regular 536))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Lee E. Hammermeister and elects Kelly R. Merrick over Jared D.
Goecker. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 551, .branch [(.regular 537, .winner (.regular 536))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 19).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [537, 536, 551] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [537, 536, 551] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.SenateDistrictL
