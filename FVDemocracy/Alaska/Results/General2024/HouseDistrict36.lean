import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 36

Contest 63 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 9,382
ballots as `contestBallots` reads them, in 276 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict36.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 548`: Pamela Goode
* `.regular 538`: Brandon P. "Putuuqti" Kowalski
* `.regular 553`: James Fields
* `.regular 539`: Rebecca A. Schwanke
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats James Fields, then Pamela Goode, and elects Rebecca A. Schwanke
  over Brandon P. "Putuuqti" Kowalski.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats James Fields, then Pamela Goode, and
  elects Rebecca A. Schwanke over Brandon P. "Putuuqti" Kowalski.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict36

open Alaska

def cands : List Cand := [.regular 548, .regular 538, .regular 553, .regular 539, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 63
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict36.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 553, .branch [(.regular 548, .branch [(.regular 538, .winner (.regular 539))])])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 553, .branch [(.regular 548, .branch [(.regular 538, .winner (.regular 539))])])] := by
  decide +kernel

/-- `tabulate` defeats James Fields, then Pamela Goode, and elects Rebecca A. Schwanke over Brandon
P. "Putuuqti" Kowalski. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 553, .branch [(.regular 548, .branch [(.regular 538, .winner (.regular 539))])])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats James Fields, then Pamela Goode, and elects Rebecca A. Schwanke
over Brandon P. "Putuuqti" Kowalski. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 553, .branch [(.regular 548, .branch [(.regular 538, .winner (.regular 539))])])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 63).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [548, 538, 553, 539] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [548, 538, 553, 539] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.HouseDistrict36
