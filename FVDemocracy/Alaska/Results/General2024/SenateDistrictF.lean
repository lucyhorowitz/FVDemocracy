import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: Senate District F

Contest 13 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 17,967
ballots as `contestBallots` reads them, in 135 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/SenateDistrictF.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 366`: James D. Kaufman
* `.regular 367`: Janice L. Park
* `.regular 368`: Harold Borbridge
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Harold Borbridge and elects James D. Kaufman over Janice L.
  Park.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Harold Borbridge and elects James D.
  Kaufman over Janice L. Park.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.SenateDistrictF

open Alaska

def cands : List Cand := [.regular 366, .regular 367, .regular 368, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 13
    "FVDemocracy/Alaska/Results/data/General2024/SenateDistrictF.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 368, .branch [(.regular 367, .winner (.regular 366))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 368, .branch [(.regular 367, .winner (.regular 366))])] := by
  decide +kernel

/-- `tabulate` defeats Harold Borbridge and elects James D. Kaufman over Janice L. Park. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 368, .branch [(.regular 367, .winner (.regular 366))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Harold Borbridge and elects James D. Kaufman over Janice L. Park.
-/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 368, .branch [(.regular 367, .winner (.regular 366))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 13).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [366, 367, 368] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [366, 367, 368] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.SenateDistrictF
