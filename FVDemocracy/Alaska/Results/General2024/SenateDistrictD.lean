import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: Senate District D

Contest 11 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 20,138
ballots as `contestBallots` reads them, in 160 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/SenateDistrictD.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 362`: Ben Carpenter
* `.regular 364`: Tina Wegener
* `.regular 365`: Jesse J. Bjorkman
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Tina Wegener and elects Jesse J. Bjorkman over Ben Carpenter.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Tina Wegener and elects Jesse J.
  Bjorkman over Ben Carpenter.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.SenateDistrictD

open Alaska

def cands : List Cand := [.regular 362, .regular 364, .regular 365, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 11
    "FVDemocracy/Alaska/Results/data/General2024/SenateDistrictD.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 364, .branch [(.regular 362, .winner (.regular 365))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 364, .branch [(.regular 362, .winner (.regular 365))])] := by
  decide +kernel

/-- `tabulate` defeats Tina Wegener and elects Jesse J. Bjorkman over Ben Carpenter. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 364, .branch [(.regular 362, .winner (.regular 365))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Tina Wegener and elects Jesse J. Bjorkman over Ben Carpenter. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 364, .branch [(.regular 362, .winner (.regular 365))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 11).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [362, 364, 365] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [362, 364, 365] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.SenateDistrictD
