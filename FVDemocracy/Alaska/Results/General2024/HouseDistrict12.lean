import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 12

Contest 39 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 8,279
ballots as `contestBallots` reads them, in 36 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict12.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 407`: Joseph M. "Joe" Lurtsema
* `.regular 408`: Calvin R. Schrage
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Calvin R. Schrage in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Calvin R. Schrage in round 1.

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict12

open Alaska

def cands : List Cand := [.regular 407, .regular 408, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 39
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict12.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 408) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 408) := by
  decide +kernel

/-- `tabulate` elects Calvin R. Schrage in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 408) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Calvin R. Schrage in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 408) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2024.HouseDistrict12
