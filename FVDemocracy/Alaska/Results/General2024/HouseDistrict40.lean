import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 40

Contest 67 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 3,170
ballots as `contestBallots` reads them, in 101 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict40.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 463`: Saima "Ikrik" Chase
* `.regular 464`: Thomas C. "Ikaaq" Baker
* `.regular 465`: Robyn "Niayuq" Burke
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Thomas C. "Ikaaq" Baker and elects Robyn "Niayuq" Burke over
  Saima "Ikrik" Chase.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Thomas C. "Ikaaq" Baker and elects Robyn
  "Niayuq" Burke over Saima "Ikrik" Chase.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict40

open Alaska

def cands : List Cand := [.regular 463, .regular 464, .regular 465, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 67
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict40.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 464, .branch [(.regular 463, .winner (.regular 465))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 464, .branch [(.regular 463, .winner (.regular 465))])] := by
  decide +kernel

/-- `tabulate` defeats Thomas C. "Ikaaq" Baker and elects Robyn "Niayuq" Burke over Saima "Ikrik"
Chase. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 464, .branch [(.regular 463, .winner (.regular 465))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Thomas C. "Ikaaq" Baker and elects Robyn "Niayuq" Burke over
Saima "Ikrik" Chase. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 464, .branch [(.regular 463, .winner (.regular 465))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 67).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [463, 464, 465] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [463, 464, 465] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.HouseDistrict40
