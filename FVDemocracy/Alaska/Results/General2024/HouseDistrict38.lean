import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 38

Contest 65 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 3,707
ballots as `contestBallots` reads them, in 291 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict38.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 457`: Willy Keppel
* `.regular 458`: C.J. McCormick
* `.regular 459`: Nellie D. "Unangik" Jimmie
* `.regular 460`: Victoria B. Sosa
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Victoria B. Sosa, then Willy Keppel, and elects Nellie D.
  "Unangik" Jimmie over C.J. McCormick.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Victoria B. Sosa, then Willy Keppel, and
  elects Nellie D. "Unangik" Jimmie over C.J. McCormick.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict38

open Alaska

def cands : List Cand := [.regular 457, .regular 458, .regular 459, .regular 460, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 65
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict38.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 460, .branch [(.regular 457, .branch [(.regular 458, .winner (.regular 459))])])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 460, .branch [(.regular 457, .branch [(.regular 458, .winner (.regular 459))])])] := by
  decide +kernel

/-- `tabulate` defeats Victoria B. Sosa, then Willy Keppel, and elects Nellie D. "Unangik" Jimmie
over C.J. McCormick. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 460, .branch [(.regular 457, .branch [(.regular 458, .winner (.regular 459))])])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Victoria B. Sosa, then Willy Keppel, and elects Nellie D.
"Unangik" Jimmie over C.J. McCormick. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 460, .branch [(.regular 457, .branch [(.regular 458, .winner (.regular 459))])])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2024-general" && r.contestId == 65).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [457, 458, 459, 460] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [457, 458, 459, 460] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.General2024.HouseDistrict38
