import FVDemocracy.Alaska.ProfileData

/-!
# 2024 general election: House District 19

Contest 46 of the CVR export `cvr/2024-general`. `profile` is `Profile.ofBallots` of its 4,739
ballots as `contestBallots` reads them, in 87 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/General2024/HouseDistrict19.json`, and writes that file from the
export first if it is missing. `cands` are the regular candidates of the contest followed by the
write-ins marked on its ballots:

* `.regular 421`: Russell O. Wyatt
* `.regular 422`: Genevieve G. Mina
* `.regular 423`: Kaylee M. Anderson
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` elects Genevieve G. Mina in round 1.
* `reproductionTabulate_eq`: `reproductionTabulate` elects Genevieve G. Mina in round 1.

Generated by `lake exe alaska cvr/2024-general --results 2024-general FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.General2024.HouseDistrict19

open Alaska

def cands : List Cand := [.regular 421, .regular 422, .regular 423, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2024-general" 46
    "FVDemocracy/Alaska/Results/data/General2024/HouseDistrict19.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .winner (.regular 422) := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .winner (.regular 422) := by
  decide +kernel

/-- `tabulate` elects Genevieve G. Mina in round 1. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .winner (.regular 422) := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` elects Genevieve G. Mina in round 1. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .winner (.regular 422) := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

end Alaska.Results.General2024.HouseDistrict19
