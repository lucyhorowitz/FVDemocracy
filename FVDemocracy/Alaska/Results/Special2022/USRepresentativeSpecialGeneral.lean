import FVDemocracy.Alaska.ProfileData

/-!
# 2022 special election: U.S. Representative (Special General)

Contest 69 of the CVR export `cvr/2022-special`. `profile` is `Profile.ofBallots` of its 192,289
ballots as `contestBallots` reads them, in 691 entries. `profile_data%` reads it from
`FVDemocracy/Alaska/Results/data/Special2022/USRepresentativeSpecialGeneral.json`, and writes that
file from the export first if it is missing. `cands` are the regular candidates of the contest
followed by the write-ins marked on its ballots:

* `.regular 215`: Nick Begich
* `.regular 217`: Sarah Palin
* `.regular 218`: Mary S. Peltola
* `.writeIn 0`: Write-in

For every election `e` with the candidates `cands` whose ballots have the rankings of `profile`:

* `tabulate_eq`: `tabulate` defeats Nick Begich and elects Mary S. Peltola over Sarah Palin.
* `reproductionTabulate_eq`: `reproductionTabulate` defeats Nick Begich and elects Mary S. Peltola
  over Sarah Palin.
* `reportRounds_eq`: the rounds of `reproductionTabulate` are those of the published report
  (`publishedReports`).

Generated by `lake exe alaska cvr/2022-special --results 2022-special FVDemocracy/Alaska/Results`.
-/

namespace Alaska.Results.Special2022.USRepresentativeSpecialGeneral

open Alaska

def cands : List Cand := [.regular 215, .regular 217, .regular 218, .writeIn 0]

def profile : Profile :=
  profile_data% "cvr/2022-special" 69
    "FVDemocracy/Alaska/Results/data/Special2022/USRepresentativeSpecialGeneral.json"

unseal Profile.tabulateRounds in
theorem profile_tabulate :
    profile.tabulate cands =
      .branch [(.regular 215, .branch [(.regular 217, .winner (.regular 218))])] := by
  decide +kernel

unseal Profile.tabulateRounds in
theorem profile_toReproduction_tabulate :
    profile.toReproduction.tabulate cands =
      .branch [(.regular 215, .branch [(.regular 217, .winner (.regular 218))])] := by
  decide +kernel

/-- `tabulate` defeats Nick Begich and elects Mary S. Peltola over Sarah Palin. -/
theorem tabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    tabulate e =
      .branch [(.regular 215, .branch [(.regular 217, .winner (.regular 218))])] := by
  rw [tabulate_eq_profileTabulate hb, hc, profile_tabulate]

/-- `reproductionTabulate` defeats Nick Begich and elects Mary S. Peltola over Sarah Palin. -/
theorem reproductionTabulate_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reproductionTabulate e =
      .branch [(.regular 215, .branch [(.regular 217, .winner (.regular 218))])] := by
  rw [reproductionTabulate_eq_profileTabulate hb, hc, profile_toReproduction_tabulate]

/-- The rounds of the published report. -/
def publishedRounds : Option (List PublishedRound) :=
  (publishedReports.find? fun r => r.election == "2022-special" && r.contestId == 69).map
    (·.rounds)

unseal Profile.singlePathRounds in
theorem profile_reportRounds :
    profile.reportRounds [215, 217, 218] cands = publishedRounds := by
  decide +kernel

/-- The rounds of `reproductionTabulate` are those of the published report. -/
theorem reportRounds_eq (e : Election) (hc : e.cands = cands)
    (hb : profile.IsProfileOf e.ballots) :
    reportRounds [215, 217, 218] e = publishedRounds := by
  rw [reportRounds_eq_profileReportRounds _ hb, hc, profile_reportRounds]

end Alaska.Results.Special2022.USRepresentativeSpecialGeneral
